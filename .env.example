# .env.example
# Copy to .env and fill values. DO NOT store real secrets in this file in source control.

# Server
PORT=3000
NODE_ENV=development

# Google Sheets - set the spreadsheet IDs (from sheet URL: /d/<ID>/...)
GOOGLE_SHEET_MEMBERS_ID=your_members_sheet_id_here
GOOGLE_SHEET_FINANCES_ID=your_finances_sheet_id_here
GOOGLE_SHEET_ACTIVITIES_ID=your_activities_sheet_id_here
GOOGLE_SHEET_PUBLICATIONS_ID=your_publications_sheet_id_here

# Service account credentials - choose one option:
# Option A (recommended): place the downloaded JSON key at server/credentials.json
#   (Leave GOOGLE_SERVICE_ACCOUNT_JSON unset.)

# Option B: set the JSON directly in the environment variable GOOGLE_SERVICE_ACCOUNT_JSON
#   - The server accepts raw JSON or base64-encoded JSON.
#   - Example (DO NOT PUT REAL KEYS IN SOURCE CONTROL):
#     GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"your-sa@project.iam.gserviceaccount.com"}

# If you prefer base64 (PowerShell example):
# $b=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content -Raw "C:\path\to\key.json"))); setx GOOGLE_SERVICE_ACCOUNT_JSON $b

# After setting credentials: share the Google Sheet with the service account's client_email and grant Editor.
